<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaiju">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Kaiju"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
    <?xml version="1.0" encoding="utf-8"?>
    <!-- REFERENCIA: no reemplaces tu archivo completo. Agrega solo las líneas marcadas con "NUEVO". -->
    <manifest xmlns:android="http://schemas.android.com/apk/res/android">

        <!-- NUEVO: recurso nativo 1 (notificaciones). Permiso peligroso desde Android 13: se pide en ejecución. -->
        <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
        <!-- NUEVO: recurso nativo 2 (cámara). Permiso peligroso: se pide en ejecución. -->
        <uses-permission android:name="android.permission.CAMERA" />
        <!-- NUEVO: la app sigue instalándose en equipos sin cámara (solo se pierde la foto). -->
        <uses-feature android:name="android.hardware.camera" android:required="false" />

        <application
            android:allowBackup="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KaijuStock">
            <!-- ...tu <activity> MainActivity tal como la trae la plantilla... -->

            <!-- NUEVO: FileProvider. Entrega a la cámara un permiso temporal para escribir SOLO la foto. -->
            <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/rutas_archivos" />
            </provider>
        </application>
    </manifest>

</manifest>